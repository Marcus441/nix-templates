{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },

  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/build/${presetName}/stage",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_COLOR_DIAGNOSTICS": "ON",
        "CMAKE_COMPILE_WARNING_AS_ERROR": "OFF"
      }
    },
    {
      "name": "dev",
      "inherits": "base",
      "displayName": "Debug with ASan/UBSan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "MYPROJECT_SANITIZERS": "address;undefined"
      }
    },
    {
      "name": "ci",
      "inherits": "base",
      "displayName": "RelWithDebInfo, warnings as errors, clang-tidy",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_COMPILE_WARNING_AS_ERROR": "ON",
        "MYPROJECT_ENABLE_CLANG_TIDY": "ON"
      }
    },
    {
      "name": "asan",
      "inherits": "base",
      "displayName": "Optimised ASan/UBSan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_COMPILE_WARNING_AS_ERROR": "ON",
        "MYPROJECT_SANITIZERS": "address;undefined"
      }
    },
    {
      "name": "tsan",
      "inherits": "base",
      "displayName": "ThreadSanitizer",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "MYPROJECT_SANITIZERS": "thread"
      }
    },
    {
      "name": "coverage",
      "inherits": "base",
      "displayName": "Debug with gcov instrumentation",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "--coverage -fprofile-update=atomic",
        "CMAKE_EXE_LINKER_FLAGS": "--coverage",
        "CMAKE_SHARED_LINKER_FLAGS": "--coverage"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "Release with LTO and hardening",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "MYPROJECT_ENABLE_IPO": "ON",
        "MYPROJECT_ENABLE_HARDENING": "ON"
      }
    }
  ],

  "buildPresets": [
    { "name": "dev", "configurePreset": "dev" },
    { "name": "ci", "configurePreset": "ci" },
    { "name": "asan", "configurePreset": "asan" },
    { "name": "tsan", "configurePreset": "tsan" },
    { "name": "coverage", "configurePreset": "coverage" },
    { "name": "release", "configurePreset": "release" }
  ],

  "testPresets": [
    {
      "name": "test-base",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "jobs": 0 },
      "environment": { "GTEST_COLOR": "1" }
    },
    {
      "name": "sanitized",
      "hidden": true,
      "inherits": "test-base",
      "environment": {
        "ASAN_OPTIONS": "abort_on_error=1:strict_string_checks=1:detect_stack_use_after_return=1",
        "UBSAN_OPTIONS": "print_stacktrace=1:halt_on_error=1"
      }
    },
    { "name": "dev", "inherits": "sanitized", "configurePreset": "dev" },
    { "name": "asan", "inherits": "sanitized", "configurePreset": "asan" },
    {
      "name": "tsan",
      "inherits": "test-base",
      "configurePreset": "tsan",
      "environment": { "TSAN_OPTIONS": "halt_on_error=1:second_deadlock_stack=1" }
    },
    { "name": "ci", "inherits": "test-base", "configurePreset": "ci" },
    { "name": "coverage", "inherits": "test-base", "configurePreset": "coverage" },
    { "name": "release", "inherits": "test-base", "configurePreset": "release" }
  ],

  "workflowPresets": [
    {
      "name": "dev",
      "steps": [
        { "type": "configure", "name": "dev" },
        { "type": "build", "name": "dev" },
        { "type": "test", "name": "dev" }
      ]
    },
    {
      "name": "ci",
      "steps": [
        { "type": "configure", "name": "ci" },
        { "type": "build", "name": "ci" },
        { "type": "test", "name": "ci" }
      ]
    },
    {
      "name": "asan",
      "steps": [
        { "type": "configure", "name": "asan" },
        { "type": "build", "name": "asan" },
        { "type": "test", "name": "asan" }
      ]
    },
    {
      "name": "tsan",
      "steps": [
        { "type": "configure", "name": "tsan" },
        { "type": "build", "name": "tsan" },
        { "type": "test", "name": "tsan" }
      ]
    },
    {
      "name": "coverage",
      "steps": [
        { "type": "configure", "name": "coverage" },
        { "type": "build", "name": "coverage" },
        { "type": "test", "name": "coverage" }
      ]
    },
    {
      "name": "release",
      "steps": [
        { "type": "configure", "name": "release" },
        { "type": "build", "name": "release" },
        { "type": "test", "name": "release" }
      ]
    }
  ]
}
